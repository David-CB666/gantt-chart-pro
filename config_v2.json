  "fields": {
    "seq": {
      "patterns": ["序號", "項次", "编号", "編號", "項號", "No", "no", "NO", "Num", "#"],
      "type": "string",
      "required": false
    },
    "name": {
      "patterns": ["施工內容", "施工項目", "項目名稱", "項目", "任務名稱", "任務描述", "工序", "工程內容", "內容", "工作內容", "名稱", "Description"],
      "type": "string",
      "required": true
    },
    "start": {
      "patterns": ["開始日期", "開始時間", "開始", "開工日期", "開工", "动工日期", "Start", "START", "start", "Sd", "SD"],
      "type": "date",
      "required": true
    },
    "end": {
      "patterns": ["完成日期", "完成時間", "完成", "完工日期", "完工", "竣工日期", "End", "END", "end", "Ed", "ED", "結束"],
      "type": "date",
      "required": false
    },
    "duration": {
      "patterns": ["工期", "持續天數", "持續", "天數", "工作天", "日數", "Duration", "DURATION", "dur", "天"],
      "type": "integer",
      "default": 1,
      "required": false
    },
    "predecessor": {
      "patterns": ["前置任務", "前置", "先行任務", "先決任務", "依賴", "Predecessor", "PRED", "pred", "FS"],
      "type": "string",
      "required": false
    },
    "material": {
      "patterns": ["材料訂貨期", "材料订货期", "材料到場", "訂貨期", "材料", "Material", "ORDER"],
      "type": "string",
      "required": false
    },
    "remark": {
      "patterns": ["備註", "備注", "說明", "Remark", "REMARK", "Note", "備考"],
      "type": "string",
      "required": false
    },
    "category": {
      "patterns": ["類別", "專業", "category", "type"],
      "type": "string",
      "default": "default",
      "required": false
    }
  },

  "calendar": {
    "type": "ask_user",
    "options": ["calendar_days", "workdays"],
    "option_labels": {
      "calendar_days": "日曆天（包含周末与节假日）",
      "workdays": "工作天（週一至週五，排除假期）"
    },
    "default": "calendar_days",
    "work_week": [1,2,3,4,5],
    "holidays": ["2026-05-01", "2026-12-20", "2026-12-21"],
    "makeup_days": ["2026-05-09"],
    "holiday_color": "HOLIDAY_BG",
    "weekend_color": "WEEKEND_BG"
  },

  "gantt_layout": {
    "target_columns": 30,
    "min_column_width": 4.0,
    "max_column_width": 7.0,
    "date_format": "MM/dd",
    "month_format": "MM月",
    "weekday_language": "zh",
    "merge_months": true,
    "show_week_numbers": false,
    "auto_adjust_width": true,
    "compact_view": false,
    "column_widths": {
      "seq": 4.2,
      "name": 40,
      "start": 10.5,
      "duration": 6,
      "end": 10.5,
      "predecessor": 10.5,
      "material": 14
    }
  },

  "output": {
    "file_pattern": "{project_name}_甘特图_{calendar_type}_{version}.xlsx",
    "overwrite": false,
    "auto_open": false,
    "export_pdf": false,
    "pdf_engine": "libreoffice",
    "default_project_name": "示例工程",
    "backup_enabled": true,
    "backup_count": 5,
    "version_suffix": "v13.2"
  },

  "data_validation": {
    "min_duration": 1,
    "max_duration": 90,
    "default_duration": 1,
    "default_predecessor_type": "FS",
    "allow_negative_dates": false,
    "max_tasks": 200,
    "strict_validation": false,
    "predecessor_format_regex": "^([A-Za-z0-9]+(?:完成)?)(?:[\\+\\-]\\d+)?$"
  },

  "dependency": {
    "auto_calculate_critical_path": true,
    "default_lag": 0,
    "supported_relations": ["FS", "SS", "FF", "SF"],
    "critical_path_algorithm": "standard"
  },

  "print": {
    "header_left": "&F",
    "header_center": "&D",
    "header_right": "&P",
    "footer_left": "Confidential",
    "footer_center": "",
    "footer_right": "Page &P of &N",
    "fit_to_pages_wide": 1,
    "fit_to_pages_tall": 0,
    "print_gridlines": true,
    "print_headings": true
  },

  "i18n": {
    "locales": ["zh_TW", "en_US", "pt_BR"],
    "fallback_locale": "zh_TW",
    "current_locale": "zh_TW",
    "translations": {
