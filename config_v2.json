  "version": "2.5",
  "schema_version": "1.4",
  "description": "甘特图生成器完整配置 - 参考VBA配色优化（柔和多彩，周末浅灰）",
  "last_updated": "2026-05-12",
  "active_scheme": "blue_pro",

  "validation": {
    "color_format": "hex",
    "required_fields": ["name", "start"],
    "date_range_limit": 730,
    "max_tasks": 200,
    "min_duration": 1,
    "max_duration": 90
  },

  "performance": {
    "max_tasks_render": 100,
    "chunk_render_size": 50,
    "cache_enabled": true,
    "preview_mode": false,
    "auto_optimize_columns": true
